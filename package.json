{
  "name": "forgehand",
  "displayName": "Forgehand",
  "description": "Editor-native coding agent. The loop runs on TrueForge. Edits stay in review until you accept each hunk.",
  "version": "1.0.0",
  "publisher": "forgehand",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["AI", "Programming Languages"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "forgehand.inlineEdit", "title": "Forgehand: Inline Edit" },
      { "command": "forgehand.openPanel", "title": "Forgehand: Open Agent" },
      { "command": "forgehand.cancel", "title": "Forgehand: Cancel" },
      { "command": "forgehand.newSession", "title": "Forgehand: New Session" },
      { "command": "forgehand.undo", "title": "Forgehand: Undo Last Applied Edit" },
      { "command": "forgehand.applyReview", "title": "Forgehand: Apply Accepted Hunks" },
      { "command": "forgehand.rejectReview", "title": "Forgehand: Reject File" },
      { "command": "forgehand.acceptHunk", "title": "Forgehand: Accept Hunk" },
      { "command": "forgehand.rejectHunk", "title": "Forgehand: Reject Hunk" },
      { "command": "forgehand.retryConnection", "title": "Forgehand: Retry Connection" }
    ],
    "keybindings": [
      {
        "command": "forgehand.inlineEdit",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Forgehand",
      "properties": {
        "forgehand.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge local server. Use localhost rather than 127.0.0.1 on Windows. The extension never calls a model provider itself."
        },
        "forgehand.model": {
          "type": "string",
          "default": "",
          "description": "Primary model FQN already configured in TrueForge, such as openai/gpt-4-1-mini. Empty uses the first configured model."
        },
        "forgehand.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Second TrueForge model. Used automatically when the primary model fails and nothing has been written. Empty uses another configured model."
        },
        "forgehand.contextBudgetTokens": {
          "type": "number",
          "default": 12000,
          "description": "Maximum tokens of automatically retrieved snippets for one retrieve_context call."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgehand",
          "title": "Forgehand",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forgehand": [
        {
          "type": "webview",
          "id": "forgehand.chat",
          "name": "Agent"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node esbuild.mjs && node --test dist-test/diff.test.js dist-test/retrieve.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "^0.185.0",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Forgehand",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: compile",
      "debugWebWorkerExtensions": false
    }
  ]
}
